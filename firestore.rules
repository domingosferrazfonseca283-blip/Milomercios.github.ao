rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'admin';
    }

    function isSeller() {
      return signedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'vendedor';
    }

    function activeSeller() {
      return isSeller()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.estadoConta == 'ativo'
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.subscricaoAtiva == true;
    }

    match /usuarios/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.tipo == 'vendedor'
        && request.resource.data.estadoConta == 'pendente'
        && request.resource.data.subscricaoAtiva == false;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.estadoConta == resource.data.estadoConta
        && request.resource.data.subscricaoAtiva == resource.data.subscricaoAtiva);
      allow delete: if isAdmin();
    }

    match /produtos/{produtoId} {
      allow read: if resource.data.ativo == true || isAdmin() || (signedIn() && resource.data.vendedorId == request.auth.uid);
      allow create: if activeSeller()
        && request.resource.data.vendedorId == request.auth.uid
        && request.resource.data.ativo == false
        && request.resource.data.estadoAprovacao == 'pendente';
      allow update: if isAdmin() || (activeSeller()
        && resource.data.vendedorId == request.auth.uid
        && request.resource.data.vendedorId == resource.data.vendedorId
        && request.resource.data.ativo == false);
      allow delete: if isAdmin() || (signedIn() && resource.data.vendedorId == request.auth.uid && resource.data.ativo == false);
    }

    match /configuracao/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /pedidosSubscricao/{pedidoId} {
      allow create: if signedIn() && isSeller() && request.resource.data.vendedorId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.vendedorId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /pedidos/{pedidoId} {
      allow read, write: if isAdmin() || (signedIn() && resource.data.clienteId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
